# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the site, used for the sitemap, robots.txt, canonical
# links and social previews. On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/revalidate (Supabase Database Webhooks).
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# Shared demo login shown on the sign-in page ("Fill Demo Login"), so visitors
# don't need a real email. Create this user in Supabase: Authentication ->
# Users -> Add user -> Create new user, with "Auto Confirm User" checked.
# Leave blank to hide the demo login. These values are public by design.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
