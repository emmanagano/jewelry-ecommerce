# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the site, used for the sitemap, robots.txt, canonical
# links and social previews. On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /api/revalidate (Supabase Database Webhooks).
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=
